      renderCustomerTickets('all');
      openTicket(newId, subj);
      notify(`Ticket ${newId} dispatched to Neural Mesh!`);
    }

    function appendTrackingMessage() {
      const input = document.getElementById('tracking-input');
      const text = input.value.trim();
      if (!text) return;
      const box = document.getElementById('tracking-thread');
      box.innerHTML += `<div class="msg user"><div class="flex justify-between" style="font-size:11px;margin-bottom:4px;"><strong>You</strong><span class="dim mono">Just now</span></div>${escapeHtml(text)}</div>`;
      input.value = '';
      setTimeout(() => {
        box.innerHTML += `<div class="msg ai"><div class="flex justify-between" style="font-size:11px;margin-bottom:4px;"><strong style="color:var(--cyan);">✦ Sylvie AI Copilot</strong><span class="dim mono">0.8s</span></div>Telemetry updated. Executing container memory check and attaching diagnostic probe to the thread.</div>`;
        box.scrollTop = box.scrollHeight;
      }, 450);
      box.scrollTop = box.scrollHeight;
    }

    function sendSylvieChat() {
      const input = document.getElementById('sylvie-input');
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      askSylvie(text);
    }

    function askSylvie(prompt) {
      const box = document.getElementById('sylvie-chat-box');
      box.innerHTML += `<div class="msg user"><div class="mono" style="font-size:11px;color:#c084fc;margin-bottom:4px;">OPERATIVE • JUST NOW</div>${escapeHtml(prompt)}</div>`;
      setTimeout(() => {
        box.innerHTML += `<div class="msg ai"><div class="mono" style="font-size:11px;color:var(--cyan);margin-bottom:4px;">✦ SYLVIE AI • 99.1% CONFIDENCE</div>Processed query: <em>"${escapeHtml(prompt)}"</em>. Cluster telemetry is nominal across 64/64 nodes; recommended remediation patch is staged and ready for 1-click deployment.</div>`;
        box.scrollTop = box.scrollHeight;
      }, 400);
      box.scrollTop = box.scrollHeight;
    }

    function clearChat() {
      document.getElementById('sylvie-chat-box').innerHTML = `<div class="msg ai"><div class="mono" style="font-size:11px;color:var(--cyan);margin-bottom:4px;">✦ SYLVIE AI</div>Neural context cleared. Ready for new diagnostic commands.</div>`;
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]));
    }

    let toastTimer;
    function notify(msg) {
      const el = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.add('hidden'), 3200);
    }

    renderCustomerTickets('all');
    renderStaffQueue();
  </script>
</body>
</html>