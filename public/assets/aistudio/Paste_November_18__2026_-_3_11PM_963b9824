  <!-- ==================== SCREEN 8: LOGIN / SELECT ACCESS TIER ==================== -->
  <section id="screen-login" class="auth-shell">
    <div class="auth-topbar">
      <div class="flex items-center gap-2">
        <div class="brand-icon" style="width:28px;height:28px;font-size:12px;">S</div>
        <div>
          <div style="font-weight:700;font-size:13px;">SmartSupport AI</div>
          <div class="dim mono" style="font-size:10px;">NEURAL GATEWAY</div>
