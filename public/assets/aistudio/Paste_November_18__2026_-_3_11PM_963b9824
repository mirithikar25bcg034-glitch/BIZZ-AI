<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmartSupport AI — Futuristic 3D Spatial Support Suite</title>
  <style>
    :root {
      --bg-base: #060913;
      --bg-panel: #0b1120;
      --bg-card: #0f172a;
      --bg-card-2: #131c31;
      --border: rgba(56, 189, 248, 0.16);
      --border-strong: rgba(34, 211, 238, 0.38);
      --cyan: #22d3ee;
      --cyan-glow: rgba(34, 211, 238, 0.25);
      --purple: #a855f7;
      --purple-glow: rgba(168, 85, 247, 0.25);
      --emerald: #10b981;
      --amber: #f59e0b;
      --rose: #f43f5e;
      --text: #e2e8f0;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --font-sans: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; background: var(--bg-base); color: var(--text); font-family: var(--font-sans); font-size: 14px; line-height: 1.45; overflow-x: hidden; }

    /* Subtle neural dot grid */
    body {
      background-image:
        radial-gradient(circle at 18% 12%, rgba(34, 211, 238, 0.08), transparent 36%),
        radial-gradient(circle at 82% 80%, rgba(168, 85, 247, 0.08), transparent 40%),
        radial-gradient(rgba(148, 163, 184, 0.12) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 24px 24px;
    }

    button, input, select, textarea { font-family: inherit; color: inherit; }
    button { cursor: pointer; border: none; background: none; }
    a { color: var(--cyan); text-decoration: none; }

    /* Utility classes */
    .hidden { display: none !important; }
    .mono { font-family: var(--font-mono); }
    .muted { color: var(--text-muted); }
    .dim { color: var(--text-dim); }
    .flex { display: flex; }
    .items-center { align-items: center; }
    .justify-between { justify-content: space-between; }
    .gap-2 { gap: 8px; }
    .gap-3 { gap: 12px; }
    .gap-4 { gap: 16px; }
    .grid { display: grid; }

    /* Badges & Pills */
    .pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
      background: rgba(34, 211, 238, 0.1); color: var(--cyan); border: 1px solid rgba(34, 211, 238, 0.25);
    }
    .pill.purple { background: rgba(168, 85, 247, 0.12); color: #c084fc; border-color: rgba(168, 85, 247, 0.3); }
    .pill.emerald { background: rgba(16, 185, 129, 0.12); color: #34d399; border-color: rgba(16, 185, 129, 0.3); }
    .pill.amber { background: rgba(245, 158, 11, 0.12); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3); }
    .pill.rose { background: rgba(244, 63, 94, 0.12); color: #fb7185; border-color: rgba(244, 63, 94, 0.3); }

    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); display: inline-block; }
    .dot.emerald { background: var(--emerald); box-shadow: 0 0 8px var(--emerald); }
    .dot.amber { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
    .dot.rose { background: var(--rose); box-shadow: 0 0 8px var(--rose); }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 9px 16px; border-radius: 10px; font-weight: 600; font-size: 13px; transition: all 0.18s ease;
      border: 1px solid var(--border); background: var(--bg-card-2); color: var(--text);
    }
    .btn:hover { border-color: var(--border-strong); transform: translateY(-1px); }
    .btn-primary {
      background: linear-gradient(135deg, #22d3ee, #818cf8);
      color: #040814; border: none; box-shadow: 0 4px 20px rgba(34, 211, 238, 0.28);
    }
    .btn-primary:hover { filter: brightness(1.08); box-shadow: 0 6px 26px rgba(34, 211, 238, 0.4); }
    .btn-purple {
      background: linear-gradient(135deg, #a855f7, #6366f1); color: #fff; border: none;
    }
    .btn-sm { padding: 6px 11px; font-size: 12px; border-radius: 8px; }

    /* Cards & Inputs */
    .card {
      background: rgba(13, 19, 34, 0.88);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
      backdrop-filter: blur(10px);
    }
    .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; gap: 12px; }
    .card-title { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }

    .input, .select, .textarea {
      width: 100%; background: rgba(6, 10, 20, 0.85); border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 10px; padding: 10px 12px; color: var(--text); font-size: 13px; outline: none; transition: border 0.15s;
    }
    .input:focus, .select:focus, .textarea:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.12); }
    .field-label { display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; }

    /* ================= AUTH / LANDING SCREENS (Screens 8 & 9) ================= */
    .auth-shell { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 24px 16px 48px; }
    .auth-topbar {
      width: 100%; max-width: 480px; display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px; border-radius: 14px; background: rgba(13, 19, 34, 0.9); border: 1px solid var(--border); margin-bottom: 24px;
    }
    .auth-container { width: 100%; max-width: 480px; display: flex; flex-direction: column; gap: 18px; }
    .auth-hero { text-align: center; }
    .auth-hero h1 { font-size: 28px; font-weight: 800; margin: 10px 0 8px; background: linear-gradient(90deg, #fff, #67e8f9, #c084fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

    .tier-card {
      padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); background: rgba(15, 23, 42, 0.75);
      cursor: pointer; transition: all 0.18s; text-align: left;
    }
    .tier-card:hover { border-color: rgba(34, 211, 238, 0.45); }
    .tier-card.active {
      border-color: var(--cyan);
      background: linear-gradient(145deg, rgba(34, 211, 238, 0.1), rgba(168, 85, 247, 0.08));
      box-shadow: 0 0 24px rgba(34, 211, 238, 0.14);
    }

    /* ================= APP WORKSPACE SHELL (Screens 1-7) ================= */
    .app-shell { display: grid; grid-template-columns: 248px 1fr; min-height: 100vh; }
    .sidebar {
      background: rgba(8, 12, 24, 0.96); border-right: 1px solid var(--border);
      padding: 18px 14px; display: flex; flex-direction: column; justify-content: space-between; position: sticky; top: 0; height: 100vh;
    }
    .brand { display: flex; align-items: center; gap: 10px; padding: 4px 8px 16px; border-bottom: 1px solid var(--border); margin-bottom: 14px; }
    .brand-icon {
      width: 34px; height: 34px; border-radius: 10px;
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      display: grid; place-items: center; font-weight: 800; color: #040814;
    }
    .nav-list { display: flex; flex-direction: column; gap: 4px; }
    .nav-item {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      padding: 10px 12px; border-radius: 10px; color: var(--text-muted); font-weight: 500; font-size: 13px; transition: all 0.15s; text-align: left; width: 100%;
    }
    .nav-item:hover { background: rgba(34, 211, 238, 0.06); color: var(--text); }
    .nav-item.active {
      background: linear-gradient(90deg, rgba(34, 211, 238, 0.18), rgba(34, 211, 238, 0.03));
      color: var(--cyan); border: 1px solid rgba(34, 211, 238, 0.28); font-weight: 600;
    }

    .main-area { display: flex; flex-direction: column; min-width: 0; }
    .topbar {
      display: flex; align-items: center; justify-content: space-between; gap: 14px;
      padding: 14px 24px; border-bottom: 1px solid var(--border); background: rgba(8, 12, 24, 0.85); backdrop-filter: blur(12px);
      position: sticky; top: 0; z-index: 20;
    }
    .search-wrap { flex: 1; max-width: 460px; position: relative; }
    .search-wrap input { padding-left: 34px; border-radius: 999px; background: rgba(15, 23, 42, 0.8); }

    .workspace-content { padding: 24px; max-width: 1440px; width: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }

    /* Screen Switcher Bar (Quick Access for Reviewer / Role Switch) */
    .role-switcher {
      display: inline-flex; background: rgba(15, 23, 42, 0.9); border: 1px solid var(--border); border-radius: 10px; padding: 3px; gap: 2px;
    }
    .role-btn { padding: 5px 10px; border-radius: 7px; font-size: 11px; font-weight: 600; color: var(--text-muted); }
    .role-btn.active { background: rgba(34, 211, 238, 0.18); color: var(--cyan); }

    /* KPI Grids */
    .kpi-grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .kpi-grid-5 { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
    .kpi-card { background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
    .kpi-val { font-size: 28px; font-weight: 800; letter-spacing: -0.02em; margin: 6px 0 2px; font-family: var(--font-mono); }

    /* Layout helpers */
    .cols-2-1 { display: grid; grid-template-columns: 1.7fr 1fr; gap: 18px; }
    .cols-1-1 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .cols-1-2 { display: grid; grid-template-columns: 320px 1fr; gap: 18px; }

    /* Funnel / Milestones */
    .steps-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .steps-row-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
    .step-box {
      padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border); background: rgba(15, 23, 42, 0.65);
      display: flex; flex-direction: column; gap: 4px;
    }
    .step-box.done { border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.08); }
    .step-box.current { border-color: var(--cyan); background: rgba(34, 211, 238, 0.12); box-shadow: 0 0 14px rgba(34, 211, 238, 0.15); }

    /* Tables */
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); padding: 10px 8px; border-bottom: 1px solid var(--border); }
    .data-table td { padding: 12px 8px; border-bottom: 1px solid rgba(148, 163, 184, 0.08); font-size: 13px; vertical-align: middle; }
    .data-table tr.clickable:hover { background: rgba(34, 211, 238, 0.06); cursor: pointer; }

    /* Chat / Neural Stream */
    .chat-box { display: flex; flex-direction: column; gap: 12px; max-height: 440px; overflow-y: auto; padding-right: 4px; }
    .msg { padding: 12px 14px; border-radius: 12px; border: 1px solid var(--border); background: rgba(15, 23, 42, 0.75); }
    .msg.user { border-color: rgba(168, 85, 247, 0.35); background: rgba(168, 85, 247, 0.08); margin-left: 28px; }
    .msg.ai { border-color: rgba(34, 211, 238, 0.3); background: rgba(12, 24, 42, 0.9); }

    /* Switch toggle */
    .toggle {
      width: 40px; height: 22px; border-radius: 999px; background: #1e293b; border: 1px solid var(--border);
      position: relative; cursor: pointer; transition: background 0.2s; flex-shrink: 0;
    }
    .toggle::after {
      content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%;
      background: #94a3b8; transition: all 0.2s;
    }
    .toggle.on { background: rgba(34, 211, 238, 0.3); border-color: var(--cyan); }
    .toggle.on::after { left: 20px; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }

    /* Hologram SVG container */
    .holo-card {
      background: radial-gradient(circle at 50% 35%, rgba(34, 211, 238, 0.16), rgba(168, 85, 247, 0.1) 50%, rgba(10, 15, 30, 0.95) 85%);
      border: 1px solid rgba(34, 211, 238, 0.28); border-radius: 14px; padding: 16px; text-align: center;
    }

    /* Toast */
    .toast {
      position: fixed; bottom: 20px; right: 20px; z-index: 99;
      background: #0f172a; border: 1px solid var(--cyan); color: var(--text);
      padding: 12px 16px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      display: flex; align-items: center; gap: 10px; font-size: 13px;
    }

    @media (max-width: 1024px) {
      .app-shell { grid-template-columns: 1fr; }
      .sidebar { display: none; }
      .kpi-grid-4, .kpi-grid-5 { grid-template-columns: repeat(2, 1fr); }
      .cols-2-1, .cols-1-1, .cols-1-2 { grid-template-columns: 1fr; }
      .steps-row, .steps-row-5 { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>

  <!-- ==================== SCREEN 9: SIGNUP / INITIATE AI WORKSPACE ==================== -->
  <section id="screen-signup" class="auth-shell hidden">
    <div class="auth-topbar">
      <div class="flex items-center gap-2">
